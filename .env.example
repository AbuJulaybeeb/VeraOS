# VeraOS Server & Telegram Configuration
PORT=3001
NODE_ENV=development
VERAOS_API_URL=http://localhost:5173

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
# Telegram Operating Mode: standalone (default runner via 'npm run bot'), embedded_polling, or webhook
TELEGRAM_MODE=standalone
# Frontend Telegram Bot Link (opened by Open Telegram Bot CTAs)
VITE_TELEGRAM_BOT_URL=https://t.me/Vera_Of_bot

# Stellar Network & RPC Configuration
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# AI Assistant Layer (Optional - for natural language prompt parsing & verdict explanations)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
